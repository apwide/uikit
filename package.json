{
  "name": "@apwide/uikit",
  "version": "6.10.0",
  "description": "Apwide ui components",
  "main": "dist/uikit.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/apwide/uikit.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "gen-stories": "node .storybook/storyGenerator.js",
    "build": "webpack --mode=production --node-env=production",
    "build-dev": "webpack --mode=development --node-env=development",
    "build-storybook": "storybook build -c .storybook -o docs",
    "storybook": "storybook dev -p 9001 -s ./public -c .storybook --ci",
    "lint": "eslint src stories tests --ext .js,.vue,.ts",
    "lint-fix": "eslint src stories tests --fix --ext .js,.vue,.ts",
    "test": "npm run lint && jest && concurrently 'npm run storybook' 'npm run cypress:test' -k -s first",
    "unit": "jest",
    "test:watch": "jest --verbose --watchAll --notify",
    "cypress:test": "wait-on http://localhost:9001 && cypress run",
    "cypress:run": "cypress run",
    "cypress:open": "cypress open",
    "prepublishOnly": "npm run build",
    "prepare": "husky install"
  },
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "vue",
    "atlassian"
  ],
  "author": "Apwide",
  "license": "MIT",
  "devDependencies": {
    "@atlaskit/css-reset": "^7.4.5",
    "@babel/helper-plugin-utils": "^7.28.6",
    "@babel/plugin-proposal-nullish-coalescing-operator": "7.18.6",
    "@babel/plugin-proposal-numeric-separator": "7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "7.20.7",
    "@babel/plugin-proposal-optional-chaining": "7.21.0",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-typescript": "^7.28.5",
    "@faker-js/faker": "^10.4.0",
    "@storybook/addon-actions": "7.6.20",
    "@storybook/addon-docs": "7.6.20",
    "@storybook/addon-essentials": "7.6.20",
    "@storybook/addon-links": "7.6.20",
    "@storybook/core-events": "7.6.20",
    "@storybook/vue3-webpack5": "7.6.20",
    "@types/dompurify": "^3.2.0",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@vue/cli-plugin-babel": "5.0.9",
    "@vue/compiler-sfc": "3.5.41",
    "@vue/eslint-config-standard": "8.0.1",
    "@vue/eslint-config-typescript": "11.0.3",
    "@vue/test-utils": "2.4.11",
    "@vue/vue3-jest": "29.2.6",
    "assert": "^2.1.0",
    "babel-loader": "^10.1.1",
    "concurrently": "^10.0.4",
    "core-js": "^3.49.0",
    "css-loader": "^7.1.4",
    "cypress": "^15.20.0",
    "dompurify": "^3.4.13",
    "eslint": "8.53.0",
    "eslint-config-prettier": "8.10.0",
    "eslint-config-standard": "17.1.0",
    "eslint-import-resolver-alias": "1.1.2",
    "eslint-plugin-cypress": "2.15.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "27.6.0",
    "eslint-plugin-standard": "5.0.0",
    "eslint-plugin-vue": "9.18.1",
    "file-loader": "6.2.0",
    "html-loader": "5.1.0",
    "husky": "9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^17.3.0",
    "mini-css-extract-plugin": "^2.10.2",
    "prettier": "2.8.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "7.6.20",
    "style-loader": "4.0.0",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "0.0.1-alpha.0",
    "vue": "3.5.41",
    "vue-docgen-api": "4.79.2",
    "vue-loader": "17.4.2",
    "vue-svg-loader": "0.17.0-beta.2",
    "wait-on": "^9.1.0",
    "webpack": "^5.109.2",
    "webpack-cli": "6.0.1"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "lint-staged": {
    "*.{js,vue}": [
      "jest --bail --findRelatedTests",
      "npm run lint-fix"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "npx --no-install lint-staged"
    }
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@fortawesome/fontawesome-svg-core": "1.2.36",
    "@fortawesome/free-brands-svg-icons": "5.15.4",
    "@fortawesome/free-regular-svg-icons": "5.15.4",
    "@fortawesome/free-solid-svg-icons": "5.15.4",
    "@fortawesome/vue-fontawesome": "2.0.10",
    "date-fns": "^4.4.0",
    "date-fns-tz": "3.2.0",
    "easymde": "^2.21.0",
    "vue-promised": "1.2.2"
  },
  "packageManager": "npm@11.12.1"
}
