{
  "name": "@apwide/uikit",
  "version": "6.10.0",
  "description": "Apwide ui components",
  "main": "dist/uikit.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/apwide/uikit.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "gen-stories": "node .storybook/storyGenerator.js",
    "build": "vite build",
    "build-dev": "vite build --mode development --minify false",
    "build-storybook": "storybook build -c .storybook -o docs",
    "storybook": "storybook dev -p 9001 -s ./public -c .storybook --ci",
    "lint": "eslint src stories tests --ext .js,.vue,.ts",
    "lint-fix": "eslint src stories tests --fix --ext .js,.vue,.ts",
    "test": "npm run lint && vitest run && concurrently 'npm run storybook' 'npm run cypress:test' -k -s first",
    "unit": "vitest run",
    "test:watch": "vitest",
    "cypress:test": "wait-on http://localhost:9001 && cypress run",
    "cypress:run": "cypress run",
    "cypress:open": "cypress open",
    "prepublishOnly": "npm run build",
    "prepare": "husky install"
  },
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "vue",
    "atlassian"
  ],
  "author": "Apwide",
  "license": "MIT",
  "devDependencies": {
    "@atlaskit/css-reset": "^7.4.5",
    "@faker-js/faker": "^10.4.0",
    "@storybook/addon-actions": "7.6.20",
    "@storybook/addon-docs": "7.6.20",
    "@storybook/addon-essentials": "7.6.20",
    "@storybook/addon-links": "7.6.20",
    "@storybook/core-events": "7.6.20",
    "@storybook/vue3-vite": "7.6.20",
    "@types/dompurify": "^3.2.0",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.59.8",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/compiler-sfc": "3.5.41",
    "@vue/eslint-config-standard": "8.0.1",
    "@vue/eslint-config-typescript": "11.0.3",
    "@vue/test-utils": "2.4.11",
    "concurrently": "^10.0.4",
    "cypress": "^15.20.0",
    "dompurify": "^3.4.13",
    "eslint": "8.53.0",
    "eslint-config-prettier": "8.10.0",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "27.6.0",
    "eslint-plugin-standard": "5.0.0",
    "eslint-plugin-vue": "9.18.1",
    "husky": "9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "2.8.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "7.6.20",
    "typescript": "5.9.2",
    "vite": "^5.4.21",
    "vitest": "^3.2.4",
    "vue": "3.5.41",
    "vue-docgen-api": "4.79.2",
    "wait-on": "^9.1.0"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "lint-staged": {
    "*.{js,vue}": [
      "vitest related --run",
      "npm run lint-fix"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "npx --no-install lint-staged"
    }
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@fortawesome/fontawesome-svg-core": "1.2.36",
    "@fortawesome/free-brands-svg-icons": "5.15.4",
    "@fortawesome/free-regular-svg-icons": "5.15.4",
    "@fortawesome/free-solid-svg-icons": "5.15.4",
    "@fortawesome/vue-fontawesome": "3.3.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "3.2.0",
    "easymde": "^2.21.0",
    "vue-promised": "1.2.2"
  },
  "packageManager": "npm@11.12.1"
}
